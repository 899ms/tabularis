{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Editor schema hint only. Tabularis validates against its bundled schema and never fetches this URL."
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])$)[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 40,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "type": "string",
      "const": "theme"
    },
    "min_runtime_version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 40,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "theme_schema_version": {
      "type": "integer",
      "const": 1
    },
    "theme_variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])$)[a-z][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "file": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^themes/(?:[A-Za-z0-9][A-Za-z0-9._-]*/){0,6}[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
          }
        },
        "required": [
          "id",
          "name",
          "file"
        ]
      }
    },
    "description": {
      "type": "string",
      "maxLength": 280
    },
    "category": {
      "type": "string",
      "maxLength": 40
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 30
      }
    },
    "license": {
      "type": "string",
      "maxLength": 40
    },
    "icon": {
      "type": "string",
      "maxLength": 500
    },
    "screenshots": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "caption": {
            "type": "string",
            "maxLength": 200
          },
          "alt": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "readme": {
      "type": "string",
      "maxLength": 500
    },
    "readmes": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
        "maxLength": 10
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 500
      }
    },
    "documentation_url": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https?://.+"
    },
    "homepage": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https?://.+"
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "issues_url": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https?://.+"
        }
      }
    }
  },
  "required": [
    "name",
    "version",
    "kind",
    "min_runtime_version",
    "theme_schema_version",
    "theme_variants"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tabularis theme package manifest v1"
}
